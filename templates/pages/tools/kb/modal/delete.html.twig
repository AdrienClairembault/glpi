{# The "Delete article" modal of an article that hosts children, see
 # `Glpi\Controller\Knowbase\DeleteModalController`. A leaf article uses the
 # plain confirmation dialog instead. #}

<form
    data-glpi-kb-delete-form
    data-glpi-kb-delete-article-id="{{ id }}"
    data-glpi-kb-delete-confirm-phrase="{{ confirm_phrase }}"
>
    {% if blocked_count > 0 %}
        {# Nothing is deleted at all in that case: the model refuses a partial
         # cascade, so the modal does not offer the action. #}
        <div class="alert alert-danger" role="alert">
            <div class="d-flex">
                <i class="ti ti-lock fs-2 me-2" aria-hidden="true"></i>
                <div>
                    <h4 class="alert-title">{{ __('This article cannot be deleted') }}</h4>
                    {{ _n(
                        'It has a sub-article you are not allowed to delete.',
                        'It has %s sub-articles you are not allowed to delete.',
                        blocked_count
                    )|format(blocked_count) }}
                    {{ __('Ask an administrator of the knowledge base to delete this branch.') }}
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-danger" role="alert">
            <div class="d-flex">
                <i class="ti ti-alert-triangle fs-2 me-2" aria-hidden="true"></i>
                <div>
                    <h4 class="alert-title">
                        {% if descendant_count > 0 %}
                            {{ _n(
                                'This action also deletes %s sub-article.',
                                'This action also deletes %s sub-articles.',
                                descendant_count
                            )|format(descendant_count) }}
                        {% else %}
                            {# Every sub-article has another parent, see below. #}
                            {{ __('This action deletes this article.') }}
                        {% endif %}
                    </h4>
                    {{ __('You cannot undo this action.') }}
                </div>
            </div>
        </div>

        {% if listed_names is not empty %}
            <div class="mb-3">
                <div class="text-muted mb-1">{{ __('Articles that this action deletes:') }}</div>
                <ul class="list-unstyled overflow-auto border rounded p-2 mb-1" style="max-height: 12rem;">
                    {% for name in listed_names %}
                        <li class="text-truncate">
                            <i class="ti ti-file-text text-muted me-1" aria-hidden="true"></i>{{ name }}
                        </li>
                    {% endfor %}
                </ul>
                {% if unlisted_count > 0 %}
                    <div class="text-muted small">
                        {{ _n('And %s more article.', 'And %s more articles.', unlisted_count)|format(unlisted_count) }}
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if unreadable_count > 0 %}
            <div class="text-muted small mb-3">
                <i class="ti ti-eye-off me-1" aria-hidden="true"></i>
                {{ _n(
                    '%s deleted sub-article is not visible to you.',
                    '%s deleted sub-articles are not visible to you.',
                    unreadable_count
                )|format(unreadable_count) }}
            </div>
        {% endif %}

        {% if kept_count > 0 %}
            <div class="text-muted small mb-3">
                <i class="ti ti-git-fork me-1" aria-hidden="true"></i>
                {{ _n(
                    '%s sub-article has another parent. It stays in the knowledge base.',
                    '%s sub-articles have another parent. They stay in the knowledge base.',
                    kept_count
                )|format(kept_count) }}
            </div>
        {% endif %}

        <div class="mb-1">
            {{ __('To confirm, type the name of the article:') }}
            <code class="text-break">{{ confirm_phrase }}</code>
        </div>
        <input
            type="text"
            class="form-control"
            autocomplete="off"
            aria-label="{{ __('Name of the article to delete') }}"
            data-glpi-kb-delete-confirm-input
        >
    {% endif %}

    <div class="d-flex mt-3">
        <button
            class="btn btn-ghost-secondary ms-auto me-2"
            type="button"
            data-bs-dismiss="modal"
        >{{ __('Cancel') }}</button>
        {% if blocked_count == 0 %}
            {# Enabled by DeleteModalController.js once the typed name matches. #}
            <button
                type="submit"
                class="btn btn-danger"
                data-glpi-kb-delete-submit
                disabled
            >{{ __('Delete') }}</button>
        {% endif %}
    </div>
</form>
